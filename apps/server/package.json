{
  "name": "@localbridge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean && node -e \"const fs=require('fs'); if (fs.existsSync('src/db/migrations')) fs.cpSync('src/db/migrations', 'dist/migrations', { recursive: true })\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@localbridge/protocol": "workspace:*",
    "@localbridge/security": "workspace:*",
    "@localbridge/shared": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
