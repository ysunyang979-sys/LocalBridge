# Nexus MCP Bridge Configuration

# Bridge Server Host and Port (Default: 127.0.0.1:8787)
NEXUS_BRIDGE_HOST=127.0.0.1
NEXUS_BRIDGE_PORT=8787

# Authentication Token for Gemini Spark / External MCP Clients
# Request must supply: Authorization: Bearer <NEXUS_BRIDGE_TOKEN>
NEXUS_BRIDGE_TOKEN=gemini-spark-nexus-secure-token-2026

# Downstream Nexus LocalBridge Core URL (Default: http://127.0.0.1:18080)
NEXUS_CORE_URL=http://127.0.0.1:18080

# Path to Nexus management key file (for auto-provisioning dedicated MCP tokens)
NEXUS_MANAGEMENT_TOKEN_PATH=C:\Users\<username>\AppData\Local\LocalBridge\data\management-token.key

# Optional: explicitly provide a downstream Nexus MCP token (lb_...)
# If left blank, the bridge will automatically acquire/refresh one using the management key
NEXUS_MCP_TOKEN=
