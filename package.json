{
  "name": "localbridge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Model Context Protocol (MCP) Bridge for Local Development",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter=@localbridge/server run build && pnpm --filter=@localbridge/runner run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest --pool=forks",
    "dev:server": "pnpm --filter @localbridge/server dev",
    "dev:runner": "pnpm --filter @localbridge/runner dev",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
